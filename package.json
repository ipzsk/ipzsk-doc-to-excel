{
  "name": "dsh-doc-to-excel",
  "version": "0.2.1",
  "description": "Word/PDF 分类整理为 Excel，原生面板、Harness 模型选择、本地解析与预算控制",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.2-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-0"
  },
  "files": [
    "lib",
    "src",
    "scripts/*.py",
    "scripts/*.swift",
    "scripts/build.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "release:pack": "node scripts/release.mjs"
  },
  "license": "MIT",
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JayceHuang/dsh-doc-to-excel.git"
  },
  "homepage": "https://github.com/JayceHuang/dsh-doc-to-excel#readme",
  "bugs": {
    "url": "https://github.com/JayceHuang/dsh-doc-to-excel/issues"
  }
}
